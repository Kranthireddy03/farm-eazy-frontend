# Production environment template — configure in Vercel/hosting dashboard, not in git.
VITE_API_URL=https://api.farm-eazy.com
VITE_SUPPORT_BASE_URL=https://support.farm-eazy.com
VITE_SUPPORT_DASHBOARD_URL=https://support.farm-eazy.com
VITE_GOOGLE_ALLOWED_ORIGINS=https://www.farm-eazy.com,https://farm-eazy.com,https://support.farm-eazy.com
VITE_API_ENCRYPTION_ENABLED=true
VITE_API_ENCRYPTION_SECRET=your-strong-32-plus-character-secret
VITE_API_GATEWAY_ENABLED=true
VITE_API_GATEWAY_CLIENT=farmeazy-frontend
VITE_API_GATEWAY_SECRET=your-gateway-hmac-secret
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_PAYMENT_SIMULATION_ENABLED=false
