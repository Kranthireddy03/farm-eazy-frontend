

{
  "buildCommand": "node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "env": {
    "VITE_API_URL": "https://farm-eazy-backend.onrender.com",
    "VITE_SUPPORT_BASE_URL": "https://support.farm-eazy.com",
    "VITE_SUPPORT_DASHBOARD_URL": "https://support.farm-eazy.com",
    "VITE_GOOGLE_ALLOWED_ORIGINS": "https://www.farm-eazy.com,https://farm-eazy.com,https://support.farm-eazy.com",
    "VITE_API_ENCRYPTION_ENABLED": "false",
    "VITE_API_GATEWAY_ENABLED": "true",
    "VITE_API_GATEWAY_CLIENT": "farmeazy-frontend",
    "VITE_GOOGLE_CLIENT_ID": "1034508002249-ms9o9tpqd0cs4jrkubhicg36oskot3a1.apps.googleusercontent.com",
    "VITE_PAYMENT_SIMULATION_ENABLED": "true"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  
  "headers": [
    {
      
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  
  "redirects": [
    {
      "source": "/old-path",
      "destination": "/new-path",
      "permanent": true
    }
  ]
}
